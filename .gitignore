# The full parent sample (~1 GB) and DR4 scan law (~11 GB). The small subset is
# committed and stays tracked; anything else dropped in here does not.
/data/*.arrow
!/data/G23H_sample_subset.arrow

# Generated: shards, indices, truth tables, figures.
/outputs/

# uv creates .venv here; uv.lock IS committed -- it is what pins the versions
# a catalog was generated with.
/.venv/

# Slurm job logs (logs/*.o%j, logs/*.e%j)
**/logs/

__pycache__/
*.py[cod]

# The catalog mirror (13.5 GB fetched by catalog/download_catalog.sh): only the
# script is tracked.
/catalog/*
!/catalog/download_catalog.sh

# Paper-figure notebooks (analysis/) and tutorials: caches are rebuilt on demand,
# supplementary figures are re-drawn by the notebooks. The notebooks themselves
# (with outputs), analysis/data/ and analysis/paper_figures/ are tracked.
/analysis/cache/
/analysis/supplementary_figures/
/tutorials/cache/
.ipynb_checkpoints/
.DS_Store
